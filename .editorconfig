# 文字コードと改行の取り決め。
# charset = utf-8 は「BOMなしのUTF-8」の意味（BOM付きは utf-8-bom）。
# 先頭にBOMが入るとバイト列を直接読むツールが U+FEFF を拾ってしまうので付けない。
#
# 注意: PowerShell 5.1 の Out-File / > はUTF-8で書くとBOMを付ける。
# このリポジトリのファイルをスクリプトから書き換えるときは
# [System.IO.File]::WriteAllText などBOMを付けない方法を使うこと。
#
# インデントはファイルによってタブと半角スペースが混在しているため、あえて指定しない。

root = true

[*]
charset = utf-8
end_of_line = lf

# PowerShell スクリプトだけはBOMを付ける。Windows PowerShell 5.1 は、BOMの無い .ps1 を
# UTF-8ではなくANSI（日本語環境ではCP932）として読むため、日本語のコメントや
# メッセージが文字化けし、化けた結果しだいでは構文エラーになって実行できない。
# 実行できることを優先し、ここだけ例外とする。
[*.ps1]
charset = utf-8-bom

# 外部ライブラリをそのまま置いてある場所。配布元のバイト列を1バイトも変えたくないので、
# 上の取り決めを適用しない（エディタが開いただけで改行や文字コードを直してしまうと、
# 配布元のSRIハッシュと突き合わせた確認ができなくなる）。
[common/vendor/**]
charset = unset
end_of_line = unset
